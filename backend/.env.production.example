# NovaCore Backend — production environment template
# Set these in your hosting provider / CI secrets (never commit real values).

SPRING_PROFILES_ACTIVE=prod

# PostgreSQL (managed database)
NOVACORE_DB_HOST=your-db-host.example.com
NOVACORE_DB_PORT=5432
NOVACORE_DB_NAME=novacore
NOVACORE_DB_USER=novacore_app
NOVACORE_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis (managed cache)
NOVACORE_REDIS_HOST=your-redis-host.example.com
NOVACORE_REDIS_PORT=6379
NOVACORE_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO, etc.)
NOVACORE_STORAGE_ENDPOINT=https://s3.amazonaws.com
NOVACORE_STORAGE_ACCESS_KEY=CHANGE_ME
NOVACORE_STORAGE_SECRET_KEY=CHANGE_ME
NOVACORE_STORAGE_BUCKET=novacore-prod
NOVACORE_STORAGE_REGION=us-east-1
NOVACORE_STORAGE_MAX_FILE_SIZE=50MB

# JWT — generate a new random secret (64+ chars recommended)
NOVACORE_JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
NOVACORE_JWT_ACCESS_EXPIRATION=15m
NOVACORE_JWT_REFRESH_EXPIRATION=7d
NOVACORE_JWT_ISSUER=novacore

# Auth (HTTPS required in production)
NOVACORE_AUTH_COOKIE_SECURE=true
NOVACORE_REQUIRE_EMAIL_VERIFICATION=true

# Public URLs — replace with your real domains
NOVACORE_CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
NOVACORE_FRONTEND_BASE_URL=https://app.yourdomain.com
NOVACORE_PUBLIC_SHARE_BASE_URL=https://app.yourdomain.com

# SMTP
NOVACORE_MAIL_HOST=smtp.example.com
NOVACORE_MAIL_PORT=587
NOVACORE_MAIL_USERNAME=your-smtp-user
NOVACORE_MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
NOVACORE_MAIL_FROM=noreply@yourdomain.com
NOVACORE_MAIL_SMTP_AUTH=true
NOVACORE_MAIL_SMTP_STARTTLS=true
NOVACORE_MAIL_HEALTH_ENABLED=false
