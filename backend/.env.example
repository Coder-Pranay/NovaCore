# Backend local environment variables
NOVACORE_DB_HOST=localhost
NOVACORE_DB_PORT=5432
NOVACORE_DB_NAME=novacore
NOVACORE_DB_USER=novacore
NOVACORE_DB_PASSWORD=novacore

NOVACORE_REDIS_HOST=localhost
NOVACORE_REDIS_PORT=6379
NOVACORE_REDIS_PASSWORD=

NOVACORE_STORAGE_ENDPOINT=http://localhost:9000
NOVACORE_STORAGE_ACCESS_KEY=minioadmin
NOVACORE_STORAGE_SECRET_KEY=minioadmin
NOVACORE_STORAGE_BUCKET=novacore
NOVACORE_STORAGE_REGION=us-east-1

# JWT (override in local/production secrets — do not commit real secrets)
NOVACORE_JWT_SECRET=novacore-dev-jwt-secret-key-change-me-32b
NOVACORE_JWT_ACCESS_EXPIRATION=15m
NOVACORE_JWT_REFRESH_EXPIRATION=7d
NOVACORE_JWT_ISSUER=novacore
