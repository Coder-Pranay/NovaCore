# NovaCore Backend — environment variables
# Copy to backend/.env for local development:
#   cp .env.example .env
#
# Spring Boot loads backend/.env automatically when you run from the backend/ folder.
# For production, set these in your host/CI secrets manager (do not commit .env).

# ---------------------------------------------------------------------------
# Profile
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# PostgreSQL (docker compose: postgres on 5432)
# ---------------------------------------------------------------------------
NOVACORE_DB_HOST=localhost
NOVACORE_DB_PORT=5432
NOVACORE_DB_NAME=novacore
NOVACORE_DB_USER=postgres
NOVACORE_DB_PASSWORD=postgras123

# ---------------------------------------------------------------------------
# Redis (docker compose maps host 6380 -> container 6379)
# ---------------------------------------------------------------------------
NOVACORE_REDIS_HOST=localhost
NOVACORE_REDIS_PORT=6380
NOVACORE_REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage — MinIO locally (docker compose on 9000)
# ---------------------------------------------------------------------------
NOVACORE_STORAGE_ENDPOINT=http://localhost:9000
NOVACORE_STORAGE_ACCESS_KEY=minioadmin
NOVACORE_STORAGE_SECRET_KEY=minioadmin
NOVACORE_STORAGE_BUCKET=novacore
NOVACORE_STORAGE_REGION=us-east-1
NOVACORE_STORAGE_MAX_FILE_SIZE=50MB

# ---------------------------------------------------------------------------
# JWT — use a unique secret per environment (minimum 32 characters)
# ---------------------------------------------------------------------------
NOVACORE_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
NOVACORE_JWT_ACCESS_EXPIRATION=15m
NOVACORE_JWT_REFRESH_EXPIRATION=7d
NOVACORE_JWT_ISSUER=novacore

# ---------------------------------------------------------------------------
# Auth cookies & email flows
# ---------------------------------------------------------------------------
NOVACORE_AUTH_COOKIE_SECURE=false
NOVACORE_REQUIRE_EMAIL_VERIFICATION=false
NOVACORE_PASSWORD_RESET_TOKEN_EXPIRATION=30m
NOVACORE_EMAIL_VERIFICATION_TOKEN_EXPIRATION=24h
NOVACORE_RESEND_VERIFICATION_COOLDOWN=60s

# ---------------------------------------------------------------------------
# URLs (must match your frontend origin for CORS + email links)
# ---------------------------------------------------------------------------
NOVACORE_CORS_ALLOWED_ORIGINS=http://localhost:3000
NOVACORE_FRONTEND_BASE_URL=http://localhost:3000
NOVACORE_PUBLIC_SHARE_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Mail — MailHog locally (docker compose: SMTP 1025, UI http://localhost:8025)
# Production: use real SMTP (SendGrid, Resend, AWS SES, etc.)
# ---------------------------------------------------------------------------
NOVACORE_MAIL_HOST=localhost
NOVACORE_MAIL_PORT=1025
NOVACORE_MAIL_FROM=noreply@novacore.local
NOVACORE_MAIL_HEALTH_ENABLED=false

# Moss photographic LoRA worker (separate Python GPU service)
NOVACORE_IMAGE_GEN_URL=http://127.0.0.1:8090
NOVACORE_IMAGE_GEN_READ_TIMEOUT_MS=2700000

# Production SMTP (uncomment and fill when deploying)
# NOVACORE_MAIL_HOST=smtp.example.com
# NOVACORE_MAIL_PORT=587
# NOVACORE_MAIL_USERNAME=your-smtp-user
# NOVACORE_MAIL_PASSWORD=your-smtp-password
# NOVACORE_MAIL_SMTP_AUTH=true
# NOVACORE_MAIL_SMTP_STARTTLS=true
