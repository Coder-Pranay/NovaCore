# NovaCore Frontend — environment variables
# Copy for local development:
#   cp .env.example .env.local
#
# Next.js loads .env.local automatically in development.

# Backend API base URL (must include /api context path)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Public site URL (sitemap, robots, metadata, share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Playwright E2E (optional — defaults work for local runs)
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# PLAYWRIGHT_API_URL=http://localhost:8080/api

# Production example:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
