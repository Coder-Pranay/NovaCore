# NovaCore — root environment overview
#
# This repo uses separate env files per app:
#   backend/.env.example  → copy to backend/.env
#   frontend/.env.example → copy to frontend/.env.local
#
# Quick start (from repo root):
#   1. docker compose -f docker/docker-compose.yml up -d
#   2. cp backend/.env.example backend/.env
#   3. cp frontend/.env.example frontend/.env.local
#   4. cd backend && ./mvnw.cmd spring-boot:run
#   5. cd frontend && npm run dev

# ---------------------------------------------------------------------------
# Local service ports (docker compose)
# ---------------------------------------------------------------------------
# PostgreSQL     localhost:5432   user/pass/db: novacore
# Redis          localhost:6380   (no password)
# MinIO API      localhost:9000   minioadmin / minioadmin
# MinIO Console  localhost:9001
# MailHog SMTP   localhost:1025
# MailHog UI     localhost:8025
# Backend API    localhost:8080/api
# Frontend       localhost:3000

# ---------------------------------------------------------------------------
# Backend — see backend/.env.example for full list
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# Frontend — see frontend/.env.example
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
