# Local GPU only — this worker does not use a cloud API.
NOVACORE_DEVICE=cuda:0
NOVACORE_LOAD_ON_START=true
NOVACORE_MOSS_MODEL=OpenMOSS-Team/MOSS-Image-SFT
NOVACORE_LORA_REPO=axiomofmind/Moss-image-nsfw-uncensored-lora
NOVACORE_LORA_SCALE=0.8
# CPU fallback when there is no NVIDIA GPU (photorealistic, slower, deterministic).
NOVACORE_CPU_MODEL=SG161222/Realistic_Vision_V5.1_noVAE
NOVACORE_CPU_STEPS=32
NOVACORE_CPU_SIZE=512
NOVACORE_CPU_GUIDANCE=7.5
HF_HOME=./models
